<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true" android:focusable="true"
    app:cardBackgroundColor="@color/plum_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/plum_surface_hi">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/tvRoomId"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka" android:textStyle="bold"
                android:textColor="@color/cream" android:textSize="17sp" />

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:id="@+id/tvServiceChip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/bg_service_chip"
                    android:fontFamily="@font/nunito" android:textStyle="bold"
                    android:paddingStart="9dp" android:paddingEnd="9dp"
                    android:paddingTop="3dp" android:paddingBottom="3dp"
                    android:textSize="11sp" />

                <TextView android:id="@+id/tvRoomSub"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/lavender_mist" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical">

            <View android:id="@+id/dotActive"
                android:layout_width="10dp" android:layout_height="10dp"
                android:background="@drawable/bg_dot" />

            <TextView android:id="@+id/tvRoomCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/lavender_mist" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
