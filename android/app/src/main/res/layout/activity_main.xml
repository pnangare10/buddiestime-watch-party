<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!--
        The page, with an optional address bar stacked above it.

        The WebView is wrapped in a vertical LinearLayout (rather than the bar being
        another gravity-positioned child of the root FrameLayout) so the bar *takes
        layout space* instead of covering the top of the page. Every other child of the
        root keeps positioning itself with layout_gravity and is unaffected; the
        fullscreen container and the chat overlay still come later in the file and so
        still draw on top.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Address bar — visible only for the Browse service (see MainActivity). -->
        <LinearLayout
            android:id="@+id/browseBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/plum_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnBrowseBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Back"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/cream"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/etBrowseUrl"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="search or type a link"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/cream"
                android:textColorHint="@color/lavender_mist"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnBrowseReload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Reload"
                android:gravity="center"
                android:text="⟳"
                android:textColor="@color/cream"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/btnBrowseGo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Go"
                android:gravity="center"
                android:text="→"
                android:textColor="@color/accent_blush"
                android:textSize="20sp" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Full-screen video container (used when Hotstar enters fullscreen mode) -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Status badge: top-right corner, shows Host / Guest / Connecting -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_badge"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- FAB: opens Join / Leave dialog -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabParty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Watch Party"
        android:src="@drawable/ic_heart"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="@color/on_accent" />

    <!-- FAB: close the other person's app (visible only while connected) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="232dp"
        android:contentDescription="Close their app"
        android:src="@drawable/ic_power"
        app:backgroundTint="@color/plum_surface_hi"
        app:tint="@color/cream"
        android:visibility="gone" />

    <!-- FAB: mic — click toggle, hold = push-to-talk (visible only while connected) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="160dp"
        android:contentDescription="Voice"
        android:src="@drawable/ic_mic"
        app:backgroundTint="@color/plum_surface_hi"
        app:tint="@color/cream"
        android:visibility="gone" />

    <!-- FAB: opens Chat dialog (visible only while connected) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:contentDescription="Chat"
        android:src="@drawable/ic_chat"
        app:backgroundTint="@color/plum_surface_hi"
        app:tint="@color/cream"
        android:visibility="gone" />

    <!-- Unread chat badge anchored to fabChat -->
    <TextView
        android:id="@+id/tvChatBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="128dp"
        android:background="@drawable/bg_badge"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Transparent chat overlay (bottom-left). Last child = top of z-order. -->
    <LinearLayout
        android:id="@+id/chatOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="72dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOverlayPeers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/svOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxHeight="260dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llOverlayMessages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/tvOverlayAmbient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:background="@drawable/bg_chat_bubble"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowOverlayInput"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/etOverlayInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:hint="say something sweet…"
                android:textColorHint="#BBFFF3F0"
                android:textColor="@color/cream"
                android:textSize="16sp"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:inputType="text"
                android:maxLength="500"
                android:imeOptions="actionSend"
                android:singleLine="true"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/btnSendHeart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:contentDescription="Send a heart"
                android:padding="6dp"
                android:text="💗"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
