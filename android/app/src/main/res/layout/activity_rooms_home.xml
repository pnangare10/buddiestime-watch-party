<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/berry_night"
    android:paddingStart="24dp" android:paddingEnd="24dp"
    android:paddingTop="28dp" android:paddingBottom="16dp">

    <!-- Greeting -->
    <TextView android:id="@+id/tvGreeting"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="@font/fredoka" android:textStyle="bold"
        android:textColor="@color/cream" android:textSize="30sp" />

    <TextView android:id="@+id/tvGreetingSub"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:layout_marginBottom="24dp"
        android:fontFamily="@font/nunito"
        android:textColor="@color/lavender_mist" android:textSize="15sp" />

    <!-- Pairing status -->
    <TextView android:id="@+id/tvPairingStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/nunito"
        android:textColor="@color/lavender_mist" android:textSize="14sp" />

    <!-- Hero: start a movie night -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnStartWatching"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clickable="true" android:focusable="true"
        app:cardBackgroundColor="?attr/colorPrimary"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:rippleColor="@color/accent_blush_deep">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical"
            android:paddingTop="22dp" android:paddingBottom="22dp">

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka" android:textStyle="bold"
                android:text="🍿  Start our movie night"
                android:textColor="@color/on_accent" android:textSize="20sp" />

            <TextView
                android:id="@+id/tvHeroSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:alpha="0.75"
                android:fontFamily="@font/nunito"
                android:text="our own little cinema"
                android:textColor="@color/on_accent" android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInviteNow"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="📤 Share invite link" />

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>

<!-- Love-note splash: inflated on cold start only, sits over everything -->
<ViewStub
    android:id="@+id/stubSplash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:inflatedId="@+id/splashOverlay"
    android:layout="@layout/layout_splash_overlay" />

</FrameLayout>
