<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@color/berry_night"
    android:paddingStart="32dp" android:paddingEnd="32dp">

    <TextView
        android:id="@+id/tvHeadline"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="@font/fredoka" android:textStyle="bold"
        android:text="💗 Joining your partner's room…"
        android:textColor="@color/cream" android:textSize="20sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/nunito"
        android:textColor="@color/lavender_mist" android:textSize="14sp"
        android:gravity="center" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPin"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Pairing PIN"
        android:visibility="gone">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="numberPassword"
            android:maxLength="8" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitPin"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Submit"
        android:visibility="gone" />

</LinearLayout>
